<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 与 AdminTokenMapper.xml 同套路，区别：user_id 为 bigint -->
<mapper namespace="ltd.newbee.mall.mapper.MallUserTokenMapper">
  <resultMap id="BaseResultMap" type="ltd.newbee.mall.entity.MallUserToken">
    <id column="user_token_id" jdbcType="BIGINT" property="userTokenId" />
    <result column="token" jdbcType="VARCHAR" property="token" />
    <result column="user_id" jdbcType="BIGINT" property="userId" />
    <result column="expires_at" jdbcType="TIMESTAMP" property="expiresAt" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>
  <sql id="Base_Column_List">
    user_token_id, token, user_id, expires_at, create_time
  </sql>

  <insert id="insert" parameterType="ltd.newbee.mall.entity.MallUserToken"
          useGeneratedKeys="true" keyProperty="userTokenId">
    insert into tb_newbee_mall_user_token (token, user_id, expires_at, create_time)
    values (#{token,jdbcType=VARCHAR}, #{userId,jdbcType=BIGINT},
            #{expiresAt,jdbcType=TIMESTAMP}, #{createTime,jdbcType=TIMESTAMP})
  </insert>

  <select id="selectByToken" parameterType="java.lang.String" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from tb_newbee_mall_user_token
    where token = #{token,jdbcType=VARCHAR}
  </select>

  <delete id="deleteByToken" parameterType="java.lang.String">
    delete from tb_newbee_mall_user_token
    where token = #{token,jdbcType=VARCHAR}
  </delete>
</mapper>
